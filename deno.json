{
  "name": "@smcardona/selfish-server",
  "version": "1.0.0",
  "description":"Server side for the bot to configure the farming sessions etc",
  "tasks": {
    "dev": "deno run --allow-all --watch src/index.ts",
    "cmd-update": "deno run --env src/bot/interaction-deployer.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "path/": "https://deno.land/std@0.203.0/path/"
  },
  "publish": {
    "include": ["src/*/**"],
    "exclude": ["node_modules"]
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "ban-types", "no-explicit-any"
      ]
    }
  },
  "exports":"./mod.ts"
}
